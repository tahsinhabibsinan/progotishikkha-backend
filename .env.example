# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
# ⚠️ Two common causes of "backend can't read from MongoDB":
#   1. Atlas → Network Access doesn't include this server's IP (add it, or
#      0.0.0.0/0 for quick testing — restrict it again for production).
#   2. The password below has special characters that need URL-encoding
#      (e.g. @ -> %40, # -> %23) — Atlas's "Connect" dialog will give you
#      the correctly-encoded string if you paste your real password in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/progoti-shikkha?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=replace_with_strong_random_secret

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Resend (Email OTP) — https://resend.com, free tier: 3,000 emails/month
#
# ⚠️ IMPORTANT — this is the #1 cause of "OTP only arrives at one email address":
# The default onboarding@resend.dev sender only works in Resend's SANDBOX mode,
# which can ONLY deliver to the email address that owns the Resend account
# itself. Every other recipient will silently fail to receive anything.
#
# To let OTPs reach real users:
#   1. Go to https://resend.com/domains and verify a domain you own
#      (add the TXT/CNAME records it gives you to your DNS).
#   2. Once verified, set EMAIL_FROM to an address on that domain, e.g.
#      EMAIL_FROM="Progoti Shikkha <noreply@yourdomain.com>"
#   3. Redeploy. Sandbox mode no longer applies once you send from a
#      verified domain — any recipient can receive OTPs.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Progoti Shikkha <onboarding@resend.dev>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
